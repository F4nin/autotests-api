pipeline {
    agent any

    parameters {
        choice(
            name: 'TEST_TYPE',
            choices: ['regression', 'users', 'authentication', 'files', 'courses', 'exercises'],
            description: 'Выберите тип тестов'
        )
    }

    environment {
        PYTEST_MARKERS = "${params.TEST_TYPE}"
        EMAIL_TO = 'qa-team@example.com'
    }

    stages {
        stage('Очистка предыдущих результатов') {
            steps {
                echo 'Очистка предыдущих результатов'
                sh 'rm -rf allure-results allure-report && mkdir -p allure-results'
            }
        }

        stage('Подготовка окружения') {
            steps {
                echo 'Сборка Docker-окружения'
                sh 'docker compose build'
            }
        }

        stage('Запуск сервисов') {
            steps {
                echo 'Запуск сервисов'
                sh 'docker compose up -d api-service'
            }
        }

        stage('Запуск выбранных тестов') {
            steps {
                echo "Запуск тестов с маркером: ${params.TEST_TYPE}"
                sh """
                    PYTEST_MARKERS=${params.TEST_TYPE} docker compose up --abort-on-container-exit test-runner

                    echo 'Копируем результаты из контейнера на хост'
                    docker cp test_runner:/app/allure-results/. allure-results/ 2>/dev/null && echo "Скопировано!" || echo "Не скопировано"

                    echo "=== Файлы ==="
                    ls -la allure-results/ | head -10
                    echo "JSON: \$(ls allure-results/*.json 2>/dev/null | wc -l)"
                """
            }
        }

        stage('Генерация Allure отчета') {
            steps {
                echo 'Генерация Allure отчета'
                allure results: [[path: 'allure-results']]
            }
        }
    }

    post {
       success {
            emailext(
                subject: "✅ Тесты пройдены: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h2>Статус сборки: УСПЕШНО</h2>
                    <p><b>Проект:</b> ${env.JOB_NAME}</p>
                    <p><b>Сборка:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Тип тестов:</b> ${params.TEST_TYPE}</p>
                    <p><b>Дата:</b> ${new Date().format('dd.MM.yyyy HH:mm:ss')}</p>
                    <p><b>Allure отчет:</b> <a href="${env.BUILD_URL}allure">${env.BUILD_URL}allure</a></p>
                """,
                to: "${EMAIL_TO}",
                mimeType: 'text/html'
            )
        }

        failure {
            emailext(
                subject: "❌ Тесты упали: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h2>Статус сборки: ОШИБКА</h2>
                    <p><b>Проект:</b> ${env.JOB_NAME}</p>
                    <p><b>Сборка:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Тип тестов:</b> ${params.TEST_TYPE}</p>
                    <p><b>Дата:</b> ${new Date().format('dd.MM.yyyy HH:mm:ss')}</p>
                    <p><b>Логи сборки:</b> <a href="${env.BUILD_URL}console">${env.BUILD_URL}console</a></p>
                """,
                to: "${EMAIL_TO}",
                mimeType: 'text/html'
            )
        }

        always {
            sh 'docker compose down -v || true'
        }
    }
}
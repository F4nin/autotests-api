pipeline {
    agent any

    parameters {
        choice(
            name: 'TEST_TYPE',
            choices: [
                'regression',
                'users',
                'authentication',
                'files',
                'courses',
                'exercises'
            ],
            description: 'Выберите тип тестов'
        )
    }

    environment {
        PYTEST_MARKERS = "${params.TEST_TYPE}"
        ALLURE_RESULTS_DIR = 'allure-results'
    }

    stages {
        stage('Очистка предыдущих результатов') {
            steps {
                echo 'Очистка предыдущих результатов'
                sh 'rm -rf allure-results allure-report && mkdir -p allure-results'
            }
        }

        stage('Подготовка окружения') {
            steps {
                echo 'Сборка Docker-окружения'
                sh 'docker compose build'
            }
        }

        stage('Запуск сервисов') {
            steps {
                echo 'Запуск сервисов'
                sh 'docker compose up -d api-service'
            }
        }

        stage('Запуск выбранных тестов') {
            steps {
                echo "Запуск тестов с маркером: ${params.TEST_TYPE}"
                sh "PYTEST_MARKERS=${params.TEST_TYPE} docker compose up --abort-on-container-exit test-runner"
            }
        }

        stage('Сбор результатов тестирования') {
            steps {
                echo 'Сбор результатов тестирования'
                sh """
                    echo "========================================="
                    echo "Статистика выполнения тестов"
                    echo "========================================="
                    echo "Тип тестов: ${params.TEST_TYPE}"

                    if [ -d "allure-results" ]; then
                        echo "Количество JSON файлов: \$(ls allure-results/*.json 2>/dev/null | wc -l)"
                        echo "Всего файлов в allure-results: \$(ls allure-results/ | wc -l)"
                    else
                        echo "Директория с результатами не найдена"
                    fi
                """
            }
        }

        stage('Генерация Allure отчета') {
            steps {
                echo 'Генерация Allure отчета'
                allure results: [[path: 'allure-results']]
            }
        }
    }

    post {
        success {
            echo '✅ Все этапы выполнены успешно!'
            echo "Тесты типа '${params.TEST_TYPE}' успешно пройдены"
        }
        failure {
            echo '❌ Ошибка при выполнении Pipeline'
        }
        always {
            echo '🧹 Очистка окружения...'
            sh 'docker compose down -v || true'
            cleanWs()
            echo '🏁 Pipeline завершен'
        }
    }
}